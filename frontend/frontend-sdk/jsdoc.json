{
  "opts": {
    "template": "node_modules/better-docs"
  },
  "tags": {
    "allowUnknownTags": ["category", "subcategory"],
    "dictionaries": ["jsdoc", "closure"]
  },
  "plugins": [
    "node_modules/better-docs/typescript",
    "node_modules/better-docs/category"
  ],
  "source": {
    "include": ["./src"],
    "includePattern": ".(ts)$",
    "exclude": [
      "./src/lib/flow-api/WebauthnManager.ts",
      "./src/lib/flow-api/auto-steps.ts",
      "./src/lib/flow-api/passkey-autofill-activation.ts",
      "./src/lib/events/Dispatcher.ts",
      "./src/lib/events/Scheduler.ts",
      "./src/lib/events/SessionChannel.ts",
      "./src/lib/events/SessionState.ts",
      "./src/lib/SessionStorage.ts",
      "./src/lib/Throttle.ts",
      "./src/lib/events/WindowActivityManager.ts"
    ]
  },
  "templates": {
    "cleverLinks": true
  },
  "markdown": {
    "idInHeadings": true
  },
  "sourceType": "module"
}
